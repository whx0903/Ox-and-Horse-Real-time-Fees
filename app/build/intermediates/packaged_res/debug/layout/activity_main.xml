<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_title"
            android:textColor="@color/text_main"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/setting_subtitle"
            android:textColor="@color/text_sub"
            android:textSize="13sp" />

        <!-- 主界面实时预览：与小组件共用同一计算引擎，数值必然一致 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_bg"
            android:padding="12dp">

            <ImageView
                android:id="@+id/iv_cat_preview"
                android:layout_width="88dp"
                android:layout_height="70dp"
                android:scaleType="fitCenter"
                android:src="@drawable/cat_idle"
                android:contentDescription="@string/widget_title" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:id="@+id/tv_amount_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¥0.00"
                    android:textColor="@color/primary"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_sub_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/salary_label"
            android:textColor="@color/text_main"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_salary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_bg"
            android:hint="@string/salary_hint"
            android:inputType="numberDecimal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_main"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/start_label"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />
                <EditText
                    android:id="@+id/et_start"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/widget_bg"
                    android:gravity="center"
                    android:hint="09:00"
                    android:inputType="text"
                    android:textColor="@color/text_main"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/end_label"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />
                <EditText
                    android:id="@+id/et_end"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_bg"
                    android:gravity="center"
                    android:hint="18:30"
                    android:inputType="text"
                    android:textColor="@color/text_main"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/time_hint"
            android:textColor="@color/text_sub"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/payday_label"
            android:textColor="@color/text_main"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_payday"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_bg"
            android:hint="@string/payday_hint"
            android:inputType="number"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_main"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/adjust_label"
            android:textColor="@color/text_main"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rg_adjust"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_before"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/adjust_before"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rb_after"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/adjust_after"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rb_none"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/adjust_none"
                android:textColor="@color/text_main"
                android:textSize="14sp" />
        </RadioGroup>

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/widget_bg"
            android:text="@string/save"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/preview_title"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_bg"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:text="-"
            android:textColor="@color/text_main"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_alarm_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/alarm_hint"
            android:textColor="@color/primary_dark"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_alarm"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_bg"
            android:text="@string/alarm_open"
            android:textColor="@color/primary_dark"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/keep_title"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/sw_keep_alive"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:text="@string/keep_switch"
            android:textColor="@color/text_main"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_keep_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keep_hint"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_diag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/widget_bg"
            android:lineSpacingExtra="3dp"
            android:padding="12dp"
            android:text="-"
            android:textColor="@color/text_main"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/layout_title"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_layout_auto"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/layout_auto"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rb_layout_compact"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/layout_compact"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rb_layout_standard"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/layout_standard"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rb_layout_large"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/layout_large"
                android:textColor="@color/text_main"
                android:textSize="14sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layout_hint"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_holiday_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="-"
            android:textColor="@color/text_sub"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/widget_tip"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
