<?xml version="1.0" encoding="utf-8"?>
<!-- 紧凑版（v1.3 尺寸自适应）。
     与标准版同样采用 0dp + layout_weight 铺满：以前这里是全 wrap_content，
     华为桌面给一个比内容高的卡片时就会在下半截留下大片空白（v1.3 修复）。
     所有 view id 与标准版一一对应，WidgetRenderer 可无条件 setText。
     默认隐藏「更新于」；极小尺寸（迷你档）由 Renderer 再隐藏标签行并把标签并入数值。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.0"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_cat"
            android:layout_width="34dp"
            android:layout_height="30dp"
            android:scaleType="fitCenter"
            android:src="@drawable/cat_idle"
            android:contentDescription="@string/widget_title" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="5dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/widget_title"
                android:textColor="@color/text_sub"
                android:textSize="8sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="¥0.00"
                android:textColor="@color/primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/lbl_today"
                android:textColor="@color/text_sub"
                android:textSize="8sp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_progress"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="1dp"
        android:max="1000"
        android:progress="0"
        android:indeterminate="false"
        android:progressDrawable="@drawable/progress_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:layout_marginTop="1dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_pay_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/lbl_pay"
                android:textColor="@color/text_sub"
                android:textSize="8sp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/tv_pay_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="-"
                android:textColor="@color/text_main"
                android:textSize="10sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_off_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/lbl_off"
                android:textColor="@color/text_sub"
                android:textSize="8sp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/tv_off_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="-"
                android:textColor="@color/text_main"
                android:textSize="10sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:layout_marginTop="1dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_fri_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/lbl_fri"
                android:textColor="@color/text_sub"
                android:textSize="8sp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/tv_fri_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="-"
                android:textColor="@color/text_main"
                android:textSize="10sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_holiday_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/lbl_holiday"
                android:textColor="@color/text_sub"
                android:textSize="8sp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/tv_holiday_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="-"
                android:textColor="@color/text_main"
                android:textSize="10sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- 紧凑版不显示「更新于」；id 必须与标准版一致，Renderer 会无条件 setText -->
    <TextView
        android:id="@+id/tv_updated"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.6"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="-"
        android:textColor="@color/text_sub"
        android:textSize="8sp"
        android:includeFontPadding="false"
        android:visibility="gone" />

</LinearLayout>
