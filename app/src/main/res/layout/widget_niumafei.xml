<?xml version="1.0" encoding="utf-8"?>
<!-- 标准/舒展版（v1.3 尺寸自适应）。
     关键：所有行都是 0dp + layout_weight，父容器给多高就铺满多高，
     不会出现「内容堆在上半截、下面一大片空白」。行内 gravity=center_vertical，
     多余高度均匀分配到各行而不是堆在底部。
     字号/内边距/猫图尺寸由 WidgetRenderer 按桌面实际尺寸在运行时缩放。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.2"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_cat"
            android:layout_width="52dp"
            android:layout_height="42dp"
            android:scaleType="fitCenter"
            android:src="@drawable/cat_idle"
            android:contentDescription="@string/widget_title" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="6dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/widget_title"
                android:textColor="@color/text_sub"
                android:textSize="10sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="¥0.00"
                android:textColor="@color/primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/lbl_today"
                android:textColor="@color/text_sub"
                android:textSize="9sp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_progress"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="2dp"
        android:max="1000"
        android:progress="0"
        android:indeterminate="false"
        android:progressDrawable="@drawable/progress_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_pay_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/lbl_pay"
                android:textColor="@color/text_sub"
                android:textSize="10sp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/tv_pay_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="-"
                android:textColor="@color/text_main"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_off_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/lbl_off"
                android:textColor="@color/text_sub"
                android:textSize="10sp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/tv_off_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="-"
                android:textColor="@color/text_main"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_fri_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/lbl_fri"
                android:textColor="@color/text_sub"
                android:textSize="10sp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/tv_fri_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="-"
                android:textColor="@color/text_main"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_holiday_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/lbl_holiday"
                android:textColor="@color/text_sub"
                android:textSize="10sp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/tv_holiday_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="-"
                android:textColor="@color/text_main"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_updated"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.6"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="-"
        android:textColor="@color/text_sub"
        android:textSize="9sp"
        android:includeFontPadding="false" />

</LinearLayout>
