<?xml version="1.0" encoding="utf-8"?>
<!-- 仅 debug 构建生效：允许 adb 直接向刷新接收器发显式广播，方便本机/模拟器调试。
     release 构建仍使用 main/AndroidManifest.xml 里的 exported=false，不扩大攻击面。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <receiver
            android:name="com.example.niumafei.WidgetRefresher"
            android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
